# ==============================================================================
# COSMO APPLE BOUTIQUE // PRODUCTION CONFIGURATION ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Prisma ORM)
# ------------------------------------------------------------------------------
# Local development uses SQLite:
DATABASE_URL="file:./dev.db"

# For production serverless deployment (Vercel / Supabase / Neon / AWS / Railway):
# Replace with your PostgreSQL connection string:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]?sslmode=require"

# ------------------------------------------------------------------------------
# 2. PAYMENT GATEWAY (Stripe // Real Credit Cards, Apple Pay, Google Pay)
# ------------------------------------------------------------------------------
# Obtain from your Stripe Dashboard (https://dashboard.stripe.com/apikeys):
# Test keys begin with 'sk_test_' and 'pk_test_'
# Live production keys begin with 'sk_live_' and 'pk_live_'
STRIPE_SECRET_KEY="your_stripe_secret_key_here"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="your_stripe_publishable_key_here"

# Stripe Webhook Signing Secret (https://dashboard.stripe.com/webhooks):
# Used to verify completed payments and trigger automatic order dispatch:
STRIPE_WEBHOOK_SECRET="your_stripe_webhook_secret_here"

# ------------------------------------------------------------------------------
# 3. TRANSACTIONAL EMAILS (Resend or SMTP)
# ------------------------------------------------------------------------------
# Resend API Key (https://resend.com):
RESEND_API_KEY="your_resend_api_key_here"
RESEND_FROM_EMAIL="COSMO Boutique <orders@yourdomain.com>"

# Optional Standard SMTP (Alternative to Resend):
# SMTP_HOST="smtp.mailgun.org"
# SMTP_PORT="587"
# SMTP_USER="postmaster@yourdomain.com"
# SMTP_PASS="your_smtp_password"

# ------------------------------------------------------------------------------
# 4. APPLICATION URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# In production on Vercel:
# NEXT_PUBLIC_APP_URL="https://your-custom-domain.com"
